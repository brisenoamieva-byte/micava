# Supabase (https://supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Kimi / Moonshot (label scan + price fallback) — https://platform.kimi.ai
# Server-only: do NOT prefix with NEXT_PUBLIC_
KIMI_API_KEY=your_kimi_api_key
# Optional override (default: kimi-k2.6)
# KIMI_MODEL=kimi-k2.6

# Gemini Flash (preferred for scan + Contar historia) — https://aistudio.google.com/apikey
# If set, takes priority over Kimi for scan-label and research-wine.
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.5-flash

# After creating the project, run the SQL in supabase/schema.sql
# (SQL Editor → New query → paste → Run).
#
# Auth → Providers → Email: enable Email.
# Optional: disable "Confirm email" for faster testing.
#
# Google login (optional):
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
#    Authorized redirect URI:
#    https://YOUR_PROJECT.supabase.co/auth/v1/callback
# 2. Supabase → Authentication → Providers → Google → enable
#    Paste Client ID + Client Secret from Google Cloud.
# 3. Supabase → Authentication → URL Configuration → Redirect URLs, add:
#    http://localhost:3000/auth/callback
#    https://your-production-domain/auth/callback
#
# Notify founder on every new account (pick one or both):
#
# A) Discord (recommended — free, instant on your phone):
#    Discord → Server → Integrations → Webhooks → New Webhook → Copy URL
# SIGNUP_WEBHOOK_URL=https://discord.com/api/webhooks/...
#
# B) Email via Resend (https://resend.com):
# RESEND_API_KEY=re_...
# FOUNDER_NOTIFY_EMAIL=you@example.com
# Optional verified sender (defaults to Resend onboarding address):
# RESEND_FROM_EMAIL=Cavatale <onboarding@resend.dev>
#
# User network + DMs (required once):
# Supabase → SQL Editor → run supabase/migrations/006_user_network.sql
# Database → Publications → supabase_realtime → ensure `messages` (and `conversations`) are enabled.
#
# Cavatale rating column (required once):
# Supabase → SQL Editor → run supabase/migrations/007_cavatale_rating.sql
#
# Kimi token metering (required once for usage persistence):
# Supabase → SQL Editor → run supabase/migrations/008_kimi_usage.sql

